@{
    ViewData["Title"] = "Features";
}

<div class="features-page">

    <div class="features-container">

        <!-- HEADER -->

        <div class="features-header">

            <span class="features-eyebrow">
                WHY CHOOSE US
            </span>

            <h1>
                Everything you need for a
                <strong>better election</strong>
            </h1>

            <p>
                Simple for students. Powerful for administrators.
                Built for modern college elections.
            </p>

        </div>


        <!-- FEATURE 1 -->

        <div class="feature-detail-card">

            <div class="feature-detail-icon">
                🔐
            </div>

            <div class="feature-detail-content">

                <span class="feature-detail-label">
                    FEATURE 01
                </span>

                <h2>
                    Secure Voting
                </h2>

                <p>
                    Our Online Voting System provides protected student
                    authentication so that only authorized students can
                    participate in college elections.
                </p>

                <div class="feature-points">

                    <div>
                        <span>✓</span>
                        Secure student login
                    </div>

                    <div>
                        <span>✓</span>
                        Authorized voter access
                    </div>

                    <div>
                        <span>✓</span>
                        Protected voting process
                    </div>

                </div>

            </div>

        </div>


        <!-- FEATURE 2 -->

        <div class="feature-detail-card">

            <div class="feature-detail-icon">
                ✓
            </div>

            <div class="feature-detail-content">

                <span class="feature-detail-label">
                    FEATURE 02
                </span>

                <h2>
                    One Student, One Vote
                </h2>

                <p>
                    Each eligible student can cast only one vote for a
                    particular election. The system checks voting status
                    before accepting a vote.
                </p>

                <div class="feature-points">

                    <div>
                        <span>✓</span>
                        One vote per election
                    </div>

                    <div>
                        <span>✓</span>
                        Duplicate voting protection
                    </div>

                    <div>
                        <span>✓</span>
                        Automatic vote validation
                    </div>

                </div>

            </div>

        </div>


        <!-- FEATURE 3 -->

        <div class="feature-detail-card">

            <div class="feature-detail-icon">
                👥
            </div>

            <div class="feature-detail-content">

                <span class="feature-detail-label">
                    FEATURE 03
                </span>

                <h2>
                    Candidate Management
                </h2>

                <p>
                    Administrators can manage candidate profiles and
                    election participation from the administration portal.
                    Candidates can be added, edited and approved before
                    voting begins.
                </p>

                <div class="feature-points">

                    <div>
                        <span>✓</span>
                        Add and edit candidates
                    </div>

                    <div>
                        <span>✓</span>
                        Candidate approval
                    </div>

                    <div>
                        <span>✓</span>
                        Candidate photo and details
                    </div>

                </div>

            </div>

        </div>


        <!-- FEATURE 4 -->

        <div class="feature-detail-card">

            <div class="feature-detail-icon">
                📊
            </div>

            <div class="feature-detail-content">

                <span class="feature-detail-label">
                    FEATURE 04
                </span>

                <h2>
                    Automatic Results
                </h2>

                <p>
                    Votes are counted automatically by the system.
                    Administrators can monitor election results, while
                    completed election results can be displayed clearly
                    and transparently.
                </p>

                <div class="feature-points">

                    <div>
                        <span>✓</span>
                        Automatic vote counting
                    </div>

                    <div>
                        <span>✓</span>
                        Candidate-wise results
                    </div>

                    <div>
                        <span>✓</span>
                        Percentage and winner display
                    </div>

                </div>

            </div>

        </div>


        <!-- BACK BUTTON -->

        <div class="features-back">

            <a asp-controller="Home"
               asp-action="Index">
                ← Back to Home
            </a>

        </div>

    </div>

</div>