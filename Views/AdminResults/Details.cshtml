@model List<OnlineVotingApplication.Controllers.CandidateResultViewModel>

@{
    ViewData["Title"] = "Election Results";

    var election =
        ViewBag.Election as OnlineVotingApplication.Models.Election;

    int totalVotes = ViewBag.TotalVotes ?? 0;

    var winner = Model
        .OrderByDescending(x => x.VoteCount)
        .FirstOrDefault();

    bool hasVotes = totalVotes > 0;
}

<div class="admin-results-details-page">

    <div class="admin-results-details-container">

        <div class="admin-results-details-top">

            <div>
                <span class="admin-results-eyebrow">
                    ADMINISTRATION
                </span>

                <h1>Election Results</h1>

                <p>
                    View the voting results and candidate performance.
                </p>
            </div>

            <a asp-controller="AdminResults"
               asp-action="Index"
               class="admin-results-back">
                ← All Elections
            </a>

        </div>


        @if (election != null)
        {
            <div class="admin-results-election-card">

                <div>
                    <span>Election</span>

                    <h2>
                        @election.ElectionName
                    </h2>

                    @if (!string.IsNullOrWhiteSpace(election.Description))
                    {
                        <p>
                            @election.Description
                        </p>
                    }
                </div>

                <div class="admin-results-status">
                    @(election.IsActive ? "ACTIVE" : "CLOSED")
                </div>

            </div>
        }


        <div class="admin-results-summary">

            <div class="admin-results-stat">
                <span>Total Votes</span>
                <strong>@totalVotes</strong>
            </div>

            <div class="admin-results-stat">
                <span>Candidates</span>
                <strong>@Model.Count</strong>
            </div>

            <div class="admin-results-stat">
                <span>Winner</span>

                <strong>
                    @(hasVotes && winner != null
                        ? winner.CandidateName
                        : "Not Available")
                </strong>
            </div>

        </div>


        @if (hasVotes && winner != null)
        {
            <div class="admin-results-winner">

                <div class="admin-results-winner-icon">
                    🏆
                </div>

                <div>

                    <span>
                        WINNING CANDIDATE
                    </span>

                    <h2>
                        @winner.CandidateName
                    </h2>

                    <p>
                        @winner.Position
                        ·
                        @winner.VoteCount vote(s)
                    </p>

                </div>

            </div>
        }
        else
        {
            <div class="admin-results-empty">

                <div>📊</div>

                <h2>No Votes Yet</h2>

                <p>
                    Results will appear here once students submit their votes.
                </p>

            </div>
        }


        @if (Model.Any())
        {
            <div class="admin-results-table-card">

                <div class="admin-results-table-header">

                    <div>
                        <span class="admin-results-eyebrow">
                            RESULT BREAKDOWN
                        </span>

                        <h2>Candidate Results</h2>
                    </div>

                </div>


                <div class="admin-results-table-wrapper">

                    <table class="admin-results-table">

                        <thead>

                            <tr>
                                <th>Rank</th>
                                <th>Candidate</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th>Votes</th>
                                <th>Percentage</th>
                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int rank = 1;
                            }

                            @foreach (var result in Model)
                            {
                                double percentage =
                                    totalVotes > 0
                                    ? (result.VoteCount * 100.0 / totalVotes)
                                    : 0;

                                <tr>

                                    <td>

                                        <div class="admin-results-rank">
                                            @rank
                                        </div>

                                    </td>

                                    <td>

                                        <div class="admin-results-candidate">

                                            @if (!string.IsNullOrEmpty(result.PhotoPath))
                                            {
                                                <img src="@result.PhotoPath"
                                                     alt="Candidate"
                                                     class="admin-results-photo" />
                                            }
                                            else
                                            {
                                                <div class="admin-results-photo-placeholder">
                                                    👤
                                                </div>
                                            }

                                            <div>
                                                <strong>
                                                    @result.CandidateName
                                                </strong>

                                                <small>
                                                    @result.CandidateCode
                                                </small>
                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        @result.Department
                                    </td>

                                    <td>
                                        @result.Position
                                    </td>

                                    <td>

                                        <strong class="admin-results-votes">
                                            @result.VoteCount
                                        </strong>

                                    </td>

                                    <td>

                                        <div class="admin-results-percentage">

                                            <div class="admin-results-progress">

                                                <div class="admin-results-progress-fill"
                                                     style="width:@percentage.ToString("0.##")%">
                                                </div>

                                            </div>

                                            <span>
                                                @percentage.ToString("0.##")%
                                            </span>

                                        </div>

                                    </td>

                                </tr>

                                rank++;
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }

    </div>

</div>