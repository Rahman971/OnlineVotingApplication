@model IEnumerable<OnlineVotingApplication.Models.Election>

@{
    ViewData["Title"] = "Election Management";
}

<div class="election-management-page">

    <div class="election-management-container">

        <!-- HEADER -->
        <div class="election-management-header">

            <div>
                <span class="election-page-label">
                    ADMIN PANEL
                </span>

                <h1>Election Management</h1>

                <p>
                    Create, manage and control college elections.
                </p>
            </div>

            <div class="election-header-actions">

                <a asp-controller="Admin"
                   asp-action="Dashboard"
                   class="election-back-btn">
                    ← Dashboard
                </a>

                <a asp-controller="AdminElection"
                   asp-action="Create"
                   class="election-create-btn">
                    + Create Election
                </a>

            </div>

        </div>

        <!-- ALERTS -->
        @if (TempData["Success"] != null)
        {
            <div class="election-alert election-success">
                ✓ @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="election-alert election-error">
                ⚠ @TempData["Error"]
            </div>
        }

        <!-- ELECTION LIST -->
        <div class="election-list-card">

            <div class="election-list-header">
                <div>
                    <h2>College Elections</h2>
                    <p>Manage all elections from this panel.</p>
                </div>

                <span class="election-count">
                    @Model.Count() Elections
                </span>
            </div>

            @if (!Model.Any())
            {
                <div class="election-empty-state">

                    <div class="election-empty-icon">
                        🗳️
                    </div>

                    <h3>No Elections Created</h3>

                    <p>
                        Create your first college election to get started.
                    </p>

                    <a asp-controller="AdminElection"
                       asp-action="Create"
                       class="election-create-btn">
                        + Create First Election
                    </a>

                </div>
            }
            else
            {
                <div class="election-table-wrapper">

                    <table class="election-table">

                        <thead>
                            <tr>
                                <th>Election</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var election in Model)
                            {
                                <tr>

                                    <td>
                                        <div class="election-name-cell">

                                            <div class="election-icon">
                                                🗳️
                                            </div>

                                            <div>
                                                <strong>
                                                    @election.ElectionName
                                                </strong>

                                                @if (!string.IsNullOrWhiteSpace(election.Description))
                                                {
                                                    <span>
                                                        @election.Description
                                                    </span>
                                                }
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        @election.StartDate.ToString("dd MMM yyyy")
                                        <small>
                                            @election.StartDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>
                                        @election.EndDate.ToString("dd MMM yyyy")
                                        <small>
                                            @election.EndDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>

                                        @if (election.IsActive)
                                        {
                                            <span class="election-status active">
                                                ● Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="election-status inactive">
                                                ● Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="election-actions">

                                            <a asp-controller="AdminElection"
                                               asp-action="Edit"
                                               asp-route-id="@election.Id"
                                               class="election-action edit">
                                                Edit
                                            </a>

                                            @if (election.IsActive)
                                            {
                                                <form asp-controller="AdminElection"
                                                      asp-action="Stop"
                                                      asp-route-id="@election.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="election-action stop">
                                                        Stop
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="AdminElection"
                                                      asp-action="Start"
                                                      asp-route-id="@election.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="election-action start">
                                                        Start
                                                    </button>

                                                </form>
                                            }

                                            @if (!election.IsActive)
                                            {
                                                <form asp-controller="AdminElection"
                                                      asp-action="Delete"
                                                      asp-route-id="@election.Id"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to delete this election?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="election-action delete">
                                                        Delete
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

        <!-- INFO -->
        <div class="election-management-info">

            <div class="info-icon">
                🔒
            </div>

            <div>
                <strong>Election Control</strong>

                <p>
                    Only administrators can create, edit, start or stop
                    elections. Candidates can be added to an election
                    after it has been created.
                </p>
            </div>

        </div>

    </div>

</div>