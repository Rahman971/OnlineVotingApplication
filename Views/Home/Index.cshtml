@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     PROFESSIONAL HERO
     ========================= -->

<section class="professional-hero">

    <div class="professional-hero-container">

        <div class="professional-hero-content">

            <div class="hero-label">
                <span class="status-dot"></span>
                SECURE ONLINE ELECTION PLATFORM
            </div>

            <h1>
                Your Voice.
                <span>Your Choice.</span>
            </h1>

            <p>
                A secure and transparent online voting system
                designed for students of
                <strong>Thulasi College of Arts and Science for Women.</strong>
            </p>

            <div class="hero-actions">

                <a asp-controller="Student"
                   asp-action="Login"
                   class="primary-action">
                    Student Login
                </a>

                <a asp-controller="Student"
                   asp-action="Register"
                   class="secondary-action">
                    Register
                </a>

            </div>

            <div class="hero-security">

                <div class="security-item">
                    <span>✓</span>
                    Secure Voting
                </div>

                <div class="security-item">
                    <span>✓</span>
                    One Student, One Vote
                </div>

                <div class="security-item">
                    <span>✓</span>
                    Transparent Results
                </div>

            </div>

        </div>


        <!-- VOTING PREVIEW -->

        <div class="professional-voting-preview">

            <div class="voting-window">

                <div class="voting-window-header">

                    <div class="window-brand">

                        <div class="window-logo">
                            TC
                        </div>

                        <div>
                            <strong>
                                Student Election
                            </strong>

                            <small>
                                Online Voting
                            </small>
                        </div>

                    </div>

                    <div class="live-status">
                        <span></span>
                        LIVE
                    </div>

                </div>


                <div class="voting-window-body">

                    <div class="election-small-title">
                        CAST YOUR VOTE
                    </div>

                    <h3>
                        Student Council Election
                    </h3>

                    <p class="text-muted">
                        Choose your preferred candidate.
                    </p>


                    <div class="candidate-preview">

                        <div class="candidate-number">
                            01
                        </div>

                        <div class="candidate-details">

                            <strong>
                                Candidate
                            </strong>

                            <span>
                                Student Council
                            </span>

                        </div>

                        <div class="empty-radio"></div>

                    </div>


                    <div class="candidate-preview">

                        <div class="candidate-number">
                            02
                        </div>

                        <div class="candidate-details">

                            <strong>
                                Candidate
                            </strong>

                            <span>
                                Student Council
                            </span>

                        </div>

                        <div class="empty-radio"></div>

                    </div>


                    <div class="candidate-preview">

                        <div class="candidate-number">
                            03
                        </div>

                        <div class="candidate-details">

                            <strong>
                                Candidate
                            </strong>

                            <span>
                                Student Council
                            </span>

                        </div>

                        <div class="empty-radio"></div>

                    </div>


                    <button type="button"
                            class="preview-vote-button">
                        Vote Securely
                    </button>


                    <div class="preview-security">
                        🔒 Your vote is protected
                    </div>

                </div>

            </div>


            <div class="floating-security-card card-one">

                <div class="floating-icon">
                    🔒
                </div>

                <div>
                    <strong>
                        Secure
                    </strong>

                    <small>
                        Protected Voting
                    </small>
                </div>

            </div>


            <div class="floating-security-card card-two">

                <div class="floating-icon">
                    ✓
                </div>

                <div>
                    <strong>
                        Verified
                    </strong>

                    <small>
                        Trusted Results
                    </small>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     TRUST BAR
     ========================= -->

<section class="trust-bar">

    <div class="trust-container">

        <div class="trust-item">
            <strong>100%</strong>
            <span>Digital Voting</span>
        </div>

        <div class="trust-item">
            <strong>1 Vote</strong>
            <span>Per Student</span>
        </div>

        <div class="trust-item">
            <strong>Secure</strong>
            <span>Student Authentication</span>
        </div>

        <div class="trust-item">
            <strong>Real-Time</strong>
            <span>Election Results</span>
        </div>

    </div>

</section>


<!-- =========================
     FEATURES
     ========================= -->

<section class="professional-section">

    <div class="professional-section-heading">

        <span class="section-label">
            WHY ONLINE VOTING
        </span>

        <h2>
            A Better Way to Conduct Elections
        </h2>

        <p>
            Simple, secure and transparent digital elections
            for our college community.
        </p>

    </div>


    <div class="professional-feature-grid">

        <div class="professional-feature-card">

            <div class="feature-number">
                01
            </div>

            <div class="professional-feature-icon">
                🔐
            </div>

            <h3>
                Secure Authentication
            </h3>

            <p>
                Students can securely access the voting
                system using their registered credentials.
            </p>

        </div>


        <div class="professional-feature-card">

            <div class="feature-number">
                02
            </div>

            <div class="professional-feature-icon">
                🗳️
            </div>

            <h3>
                Easy Voting
            </h3>

            <p>
                Select your preferred candidate and cast
                your vote through a simple digital process.
            </p>

        </div>


        <div class="professional-feature-card">

            <div class="feature-number">
                03
            </div>

            <div class="professional-feature-icon">
                📊
            </div>

            <h3>
                Transparent Results
            </h3>

            <p>
                Election results can be monitored and
                displayed digitally after the election.
            </p>

        </div>


        <div class="professional-feature-card">

            <div class="feature-number">
                04
            </div>

            <div class="professional-feature-icon">
                📱
            </div>

            <h3>
                Accessible Anywhere
            </h3>

            <p>
                Access the voting portal from computers,
                tablets and mobile devices.
            </p>

        </div>

    </div>

</section>


<!-- =========================
     HOW IT WORKS
     ========================= -->

<section class="process-professional">

    <div class="professional-section-heading">

        <span class="section-label">
            HOW IT WORKS
        </span>

        <h2>
            Vote in Four Simple Steps
        </h2>

        <p>
            The entire voting process is simple and easy to understand.
        </p>

    </div>


    <div class="professional-process-grid">

        <div class="process-card">

            <div class="process-top">
                <span>01</span>
            </div>

            <h3>
                Register
            </h3>

            <p>
                Create your student account using
                your college details.
            </p>

        </div>


        <div class="process-card">

            <div class="process-top">
                <span>02</span>
            </div>

            <h3>
                Login
            </h3>

            <p>
                Sign in securely to access the
                student voting portal.
            </p>

        </div>


        <div class="process-card">

            <div class="process-top">
                <span>03</span>
            </div>

            <h3>
                Vote
            </h3>

            <p>
                View candidates and select your
                preferred candidate.
            </p>

        </div>


        <div class="process-card">

            <div class="process-top">
                <span>04</span>
            </div>

            <h3>
                Results
            </h3>

            <p>
                View election results after the
                voting period ends.
            </p>

        </div>

    </div>

</section>


<!-- =========================
     CALL TO ACTION
     ========================= -->

<section class="professional-cta">

    <div class="cta-inner">

        <div class="cta-symbol">
            🗳️
        </div>

        <div class="cta-text">

            <h2>
                Ready to Make Your Voice Count?
            </h2>

            <p>
                Login to the student portal and participate
                in your college election.
            </p>

        </div>

        <a asp-controller="Student"
           asp-action="Login"
           class="cta-professional-button">
            Start Voting
        </a>

    </div>

</section>