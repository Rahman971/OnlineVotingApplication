@{
    ViewData["Title"] = "Reset Password";
}

<div class="student-forgot-page">

    <div class="student-forgot-container">

        <div class="student-forgot-card">

            <div class="student-forgot-header">

                <div class="student-forgot-icon">
                    🔑
                </div>

                <span class="student-forgot-eyebrow">
                    STUDENT PORTAL
                </span>

                <h1>Create New Password</h1>

                <p>
                    Enter a new password for your student account.
                </p>

            </div>


            @if (ViewBag.Error != null)
            {
                <div class="student-forgot-error">
                    @ViewBag.Error
                </div>
            }


            <form asp-controller="Student"
                  asp-action="ResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="student-forgot-field">

                    <label>
                        New Password
                    </label>

                    <input type="password"
                           name="newPassword"
                           class="student-forgot-input"
                           placeholder="Enter new password"
                           autocomplete="new-password" />

                </div>


                <div class="student-forgot-field">

                    <label>
                        Confirm New Password
                    </label>

                    <input type="password"
                           name="confirmPassword"
                           class="student-forgot-input"
                           placeholder="Confirm new password"
                           autocomplete="new-password" />

                </div>


                <button type="submit"
                        class="student-forgot-button">

                    Reset Password

                    <span>→</span>

                </button>

            </form>


            <div class="student-forgot-footer">

                <a asp-controller="Student"
                   asp-action="Login">

                    ← Back to Student Login

                </a>

            </div>

        </div>

    </div>

</div>