@{
    ViewData["Title"] = "Forgot Password";
}

<div class="student-forgot-page">

    <div class="student-forgot-container">

        <div class="student-forgot-card">

            <div class="student-forgot-header">

                <div class="student-forgot-icon">
                    🔐
                </div>

                <span class="student-forgot-eyebrow">
                    STUDENT PORTAL
                </span>

                <h1>Forgot Password?</h1>

                <p>
                    Verify your student account to reset your password.
                </p>

            </div>


            <form asp-controller="Student"
                  asp-action="ForgotPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="student-forgot-field">

                    <label>
                        Student ID
                    </label>

                    <input type="text"
                           name="studentId"
                           class="student-forgot-input"
                           placeholder="Enter your Student ID"
                           autocomplete="username" />

                </div>


                <div class="student-forgot-field">

                    <label>
                        Registered Email
                    </label>

                    <input type="email"
                           name="email"
                           class="student-forgot-input"
                           placeholder="Enter your registered email"
                           autocomplete="email" />

                </div>


                <button type="submit"
                        class="student-forgot-button">

                    Continue

                    <span>→</span>

                </button>

            </form>


            <div class="student-forgot-footer">

                <a asp-controller="Student"
                   asp-action="Login">

                    ← Back to Student Login

                </a>

            </div>

        </div>

    </div>

</div>