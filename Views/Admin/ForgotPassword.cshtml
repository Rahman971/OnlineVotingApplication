@{
    ViewData["Title"] = "Forgot Password";
}

<div class="admin-auth-page">
    <div class="admin-auth-card">

        <div class="admin-auth-logo">TC</div>

        <h1>Forgot Password?</h1>

        <p class="admin-auth-subtitle">
            Enter your registered admin email address.
            We'll send you a 6-digit OTP.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="admin-auth-error">
                @ViewBag.Error
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="admin-auth-success">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Admin"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <label>Email Address</label>

            <input type="email"
                   name="email"
                   class="admin-auth-input"
                   placeholder="Enter registered email"
                   autocomplete="email"
                   required />

            <button type="submit"
                    class="admin-auth-button">
                Send OTP
            </button>
        </form>

        <a asp-controller="Admin"
           asp-action="Login"
           class="admin-auth-back">
            ← Back to Admin Login
        </a>

    </div>
</div>

<style>
    .admin-auth-page {
        min-height: calc(100vh - 78px);
        background: #f4f7fb;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .admin-auth-card {
        width: 100%;
        max-width: 460px;
        background: #fff;
        padding: 42px;
        border-radius: 20px;
        box-shadow: 0 15px 45px rgba(7,27,58,.12);
    }

    .admin-auth-logo {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: #071b3a;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 20px;
        margin-bottom: 22px;
    }

    .admin-auth-card h1 {
        color: #071b3a;
        font-size: 30px;
        margin-bottom: 10px;
    }

    .admin-auth-subtitle {
        color: #718096;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .admin-auth-card label {
        display: block;
        font-weight: 700;
        color: #263b56;
        margin-bottom: 8px;
    }

    .admin-auth-input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #dce4ee;
        border-radius: 10px;
        outline: none;
        margin-bottom: 18px;
        font-size: 15px;
    }

        .admin-auth-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37,99,235,.10);
        }

    .admin-auth-button {
        width: 100%;
        border: 0;
        border-radius: 10px;
        padding: 14px;
        background: #071b3a;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
    }

        .admin-auth-button:hover {
            background: #0d2c58;
        }

    .admin-auth-error,
    .admin-auth-success {
        padding: 12px 14px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-size: 14px;
    }

    .admin-auth-error {
        background: #fff0f0;
        color: #c93636;
    }

    .admin-auth-success {
        background: #e7f8ee;
        color: #16834a;
    }

    .admin-auth-back {
        display: block;
        text-align: center;
        margin-top: 22px;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
    }
</style>