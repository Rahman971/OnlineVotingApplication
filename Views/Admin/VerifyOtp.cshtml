@{
    ViewData["Title"] = "Verify OTP";
    var email = ViewBag.Email as string ?? "";
}

<div class="admin-auth-page">

    <div class="admin-auth-card">

        <div class="admin-auth-logo">
            <span>TC</span>
        </div>

        <h1>Verify OTP</h1>

        <p class="admin-auth-subtitle">
            A 6-digit OTP has been sent to
            <strong>@email</strong>.
            <br />
            The OTP is valid for 5 minutes.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="admin-auth-error">
                @ViewBag.Error
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="admin-auth-success">
                @TempData["Success"]
            </div>
        }

        <form asp-controller="Admin"
              asp-action="VerifyOtp"
              method="post">

            @Html.AntiForgeryToken()

            <div class="admin-auth-field">

                <label for="otp">
                    Enter OTP
                </label>

                <input type="text"
                       id="otp"
                       name="otp"
                       maxlength="6"
                       minlength="6"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       placeholder="000000"
                       autocomplete="one-time-code"
                       required
                       style="text-align:center;
                font-size:24px;
                font-weight:800;
                letter-spacing:8px;" />

            </div>

            <button type="submit"
                    class="admin-auth-button">
                Verify OTP
            </button>

        </form>

        <form asp-controller="Admin"
              asp-action="ResendOtp"
              method="post"
              style="margin-top:15px;">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="admin-resend-button">
                Resend OTP
            </button>

        </form>

        <a asp-controller="Admin"
           asp-action="ForgotPassword"
           class="admin-auth-back">
            ← Change Email
        </a>

    </div>

</div>

<style>
    .admin-auth-page {
        min-height: calc(100vh - 80px);
        background: #f5f8fc;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
    }

    .admin-auth-card {
        width: 100%;
        max-width: 450px;
        background: #fff;
        border-radius: 20px;
        padding: 42px;
        box-shadow: 0 18px 50px rgba(20,50,90,.12);
        border: 1px solid #e1e8f0;
        text-align: center;
    }

    .admin-auth-logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        border-radius: 16px;
        background: #071b3a;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 800;
    }

    .admin-auth-card h1 {
        margin: 0;
        color: #071b3a;
        font-size: 28px;
        font-weight: 800;
    }

    .admin-auth-subtitle {
        margin: 12px 0 28px;
        color: #718096;
        line-height: 1.7;
        font-size: 14px;
    }

    .admin-auth-field {
        text-align: left;
        margin-bottom: 20px;
    }

        .admin-auth-field label {
            display: block;
            margin-bottom: 8px;
            color: #102542;
            font-size: 14px;
            font-weight: 700;
        }

        .admin-auth-field input {
            width: 100%;
            height: 55px;
            border: 1px solid #d8e0ea;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
        }

            .admin-auth-field input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37,99,235,.10);
            }

    .admin-auth-button {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 10px;
        background: #071b3a;
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

        .admin-auth-button:hover {
            background: #0d2c58;
        }

    .admin-resend-button {
        background: transparent;
        border: none;
        color: #2563eb;
        font-weight: 700;
        cursor: pointer;
        font-size: 14px;
    }

    .admin-auth-error,
    .admin-auth-success {
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
        font-size: 13px;
        text-align: left;
    }

    .admin-auth-error {
        background: #fff0f0;
        color: #c93636;
    }

    .admin-auth-success {
        background: #e7f8ee;
        color: #16834a;
    }

    .admin-auth-back {
        display: inline-block;
        margin-top: 20px;
        color: #2563eb;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

</style>