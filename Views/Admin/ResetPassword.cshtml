@{
    ViewData["Title"] = "Reset Password";
}

<div class="admin-auth-page">

    <div class="admin-auth-card">

        <div class="admin-auth-logo">
            <span>TC</span>
        </div>

        <h1>Create New Password</h1>

        <p class="admin-auth-subtitle">
            OTP verified successfully.
            Create a new secure password for your administrator account.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="admin-auth-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Admin"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div class="admin-auth-field">

                <label for="newPassword">
                    New Password
                </label>

                <input type="password"
                       id="newPassword"
                       name="newPassword"
                       placeholder="Enter new password"
                       minlength="8"
                       autocomplete="new-password"
                       required />

            </div>

            <div class="admin-auth-field">

                <label for="confirmPassword">
                    Confirm Password
                </label>

                <input type="password"
                       id="confirmPassword"
                       name="confirmPassword"
                       placeholder="Confirm new password"
                       minlength="8"
                       autocomplete="new-password"
                       required />

            </div>

            <div class="password-note">
                Password must contain at least 8 characters.
            </div>

            <button type="submit"
                    class="admin-auth-button">
                Reset Password
            </button>

        </form>

    </div>

</div>

<style>
    .admin-auth-page {
        min-height: calc(100vh - 80px);
        background: #f5f8fc;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 20px;
    }

    .admin-auth-card {
        width: 100%;
        max-width: 450px;
        background: #fff;
        border-radius: 20px;
        padding: 42px;
        box-shadow: 0 18px 50px rgba(20,50,90,.12);
        border: 1px solid #e1e8f0;
    }

    .admin-auth-logo {
        width: 64px;
        height: 64px;
        margin: 0 auto 20px;
        border-radius: 16px;
        background: #071b3a;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 800;
    }

    .admin-auth-card h1 {
        text-align: center;
        margin: 0;
        color: #071b3a;
        font-size: 27px;
        font-weight: 800;
    }

    .admin-auth-subtitle {
        text-align: center;
        margin: 12px 0 28px;
        color: #718096;
        line-height: 1.6;
        font-size: 14px;
    }

    .admin-auth-field {
        margin-bottom: 18px;
    }

        .admin-auth-field label {
            display: block;
            margin-bottom: 8px;
            color: #102542;
            font-size: 14px;
            font-weight: 700;
        }

        .admin-auth-field input {
            width: 100%;
            height: 50px;
            padding: 0 15px;
            border: 1px solid #d8e0ea;
            border-radius: 10px;
            outline: none;
            box-sizing: border-box;
            font-size: 14px;
        }

            .admin-auth-field input:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 3px rgba(37,99,235,.10);
            }

    .password-note {
        background: #edf4ff;
        color: #31577f;
        padding: 11px 13px;
        border-radius: 9px;
        font-size: 12px;
        margin-bottom: 20px;
    }

    .admin-auth-button {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 10px;
        background: #071b3a;
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

        .admin-auth-button:hover {
            background: #0d2c58;
        }

    .admin-auth-error {
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
        background: #fff0f0;
        color: #c93636;
        font-size: 13px;
    }

</style>